library(readxl)
library(ggplot2)
library(tidyverse)
#File --> import dataset --> excel --> selecteer juiste tablad/sheet
data <- read.csv2("data plant.csv")
str(data)
#de type data van behandeling en gewicht van blad moeten worden aangepast
data$behandeling <- as.factor(data$behandeling)
data$gewicht.blad <- as.numeric(data$gewicht.blad)
#De specific leaf area en chlorofyl concentraties moeten worden berekend met de absorptiewaardes van ver
data$SLA <- data$bladopp / data$gewicht.blad
data$Ca <- 13.36 * data$A664.2 - 5.19 * data$A648.6
data$Cb <- 27.43 * data$A648.6 - 8.12 * data$A664.2
data$Cc <- 27.43 * data$A648.6 - 8.12 * data$A664.2
data$Ctot <- 5.24 * data$A664.2 + 22.24 * data$A648.6
# eenheden van bovenstaande parameters zijn microgram/ml plant extract oplossing
#laten we een gemiddelde waarde voor de 3 spadmetingen gebruiken
data <- data %>%
mutate(SPAD = rowMeans(across(c(SPAD1, SPAD2, SPAD.3)), na.rm = TRUE))
str(data)
m1 <- lm(data$Ctot ~ data$behandeling)
plot(resid(m1))
anova(m1)
ggplot(data, aes(y = Ctot * 10, x = behandeling))+
geom_boxplot()+
xlab("Behandeling")+
ylab("Chloropyl(a+b) gehalte (μg/g)")+
theme_bw()+
theme(axis.title = element_text(s))
ggplot(data, aes(y = Ctot * 10, x = behandeling))+
geom_boxplot()+
xlab("Behandeling")+
ylab("Chloropyl(a+b) gehalte (μg/g)")+
theme_bw()+
theme(axis.title = element_text(size = 15))
m2 <- lm(data$SPAD ~ data$Ctot)
plot(resid(m2))
anova(m2)
ggplot(data, aes(y = SPAD ,x = Ctot,colour = behandeling))+
geom_point()+
xlab("Chloropyl(a+b) gehalte (μg/g)")+
ylab("SPAD")+
theme_bw()+
theme(axis.title=element_text(size=15))
m1 <- lm(data$RGR ~ data$behandeling)
plot(resid(m1))
anova(m1)
ggplot(data, aes(y = RGR,x = behandeling))+
geom_boxplot()+
xlab("Behandeling")+
ylab("Relatieve groeisnelheid (g/g/dag)")+
theme_bw()+
theme(axis.title = element_text)
ggplot(data, aes(y = RGR,x = behandeling))+
geom_boxplot()+
xlab("Behandeling")+
ylab("Relatieve groeisnelheid (g/g/dag)")+
theme_bw()+
theme(axis.title = element_text(size = 15))
